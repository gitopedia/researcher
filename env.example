# GitHub Configuration
# Option 1: Personal Access Token (PAT)
GITHUB_TOKEN=

# Option 2: GitHub App Authentication (recommended)
# App ID from GitHub App settings
GITHUB_APP_ID=
# Path to private key PEM file, OR the key content itself
GITHUB_APP_PRIVATE_KEY_PATH=
# OR use GITHUB_APP_PRIVATE_KEY to provide key content directly
# GITHUB_APP_PRIVATE_KEY=
# Installation ID (optional - will auto-detect if not provided)
# GITHUB_APP_INSTALLATION_ID=

# LLM Configuration (Ollama / self-hosted)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Global models
# LLM_MODEL_FAST: smaller/faster model (JSON conversion, utility tasks)
# LLM_MODEL_DETAILED: larger/more capable model (article generation and summarization)
LLM_MODEL_FAST=gemma3:12b
LLM_MODEL_DETAILED=qwen3:14b

# Optional per-task overrides (fallback to FAST/DETAILED)
LLM_MODEL_GENERATE_ARTICLE=
LLM_MODEL_EXTRACT_ENTITIES=
LLM_MODEL_SUGGEST_TOPICS=
LLM_MODEL_SUMMARIZE_PLAIN=
LLM_MODEL_SUMMARIZE_JSON=

# Search Configuration
# (No API key needed for DuckDuckGo currently)
# Max number of sources (web pages) to fetch per topic
SEARCH_MAX_SOURCES=30
# Number of different search queries to perform per topic (for variety)
SEARCH_NUM_QUERIES=5
# Max number of results to return per search query
# DuckDuckGo HTML pages typically show 20-30 results, so set this to 50 to get all results from first page
SEARCH_RESULTS_PER_QUERY=50
# Max number of concurrent headless fetches
SEARCH_MAX_FETCH_CONCURRENCY=3
# Max characters of raw page text to keep before summarization
# (128000 ≈ ~32k–40k tokens of raw text; summarization will compress this)
SEARCH_MAX_CHARS=128000

# Debugging / Observability
# When enabled, the agent will save raw fetched pages and LLM outputs for each
# source under Compendium/_debug/sources/ in the PR branch for inspection.
# WARNING: This can generate large files and should be used for debugging only.
RESEARCH_DEBUG_SOURCES=false

# Execution Configuration
MAX_TOPICS_PER_RUN=10

