# GitHub Configuration
# Option 1: Personal Access Token (PAT)
GITHUB_TOKEN=

# Option 2: GitHub App Authentication (recommended)
# App ID from GitHub App settings
GITHUB_APP_ID=
# Path to private key PEM file, OR the key content itself
GITHUB_APP_PRIVATE_KEY_PATH=
# OR use GITHUB_APP_PRIVATE_KEY to provide key content directly
# GITHUB_APP_PRIVATE_KEY=
# Installation ID (optional - will auto-detect if not provided)
# GITHUB_APP_INSTALLATION_ID=

# LLM Configuration (Ollama / self-hosted)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Multi-model configuration for optimized performance
# Fast tasks (topic suggestion, JSON conversion): use smaller model
LLM_MODEL_FAST=qwen3:8b
# Entity extraction: medium model
LLM_MODEL_ENTITY=qwen3:14b
# Article generation: large model for quality
LLM_MODEL_ARTICLE=qwen3:32b

# Phase 1: Information Gathering
# Overall target number of summarized web pages to gather and process
PHASE1_TARGET_SOURCES=20
# Phase 1: Number of different search queries to perform per topic (for variety)
PHASE1_SEARCH_NUM_QUERIES=10
# Target number of summaries to collect per search query (sources that pass relevance and word count checks)
TARGET_SUMMARIES_PER_QUERY=5

# Phase 2: Detailed Research and refinement


# DuckDuckGo Web Search Config
# Max number of concurrent headless fetches
SEARCH_MAX_FETCH_CONCURRENCY=3
# Search results to grab, too many seems to break
SEARCH_RESULTS_PER_QUERY=20
# Max characters of raw page text to keep before summarization
# (200000 ≈ ~57k–70k tokens of raw text; summarization will compress this to fit in 40k token context)
SEARCH_MAX_CHARS=200000

# Debugging / Observability
# When enabled, the agent will save raw fetched pages and LLM outputs for each
# source under Compendium/_debug/sources/ in the PR branch for inspection.
# WARNING: This can generate large files and should be used for debugging only.
RESEARCH_DEBUG_SOURCES=false

# Execution Configuration
MAX_TOPICS_PER_RUN=10

# Source Summary Configuration
# Minimum word count for source summaries (sources below this will be skipped)
SOURCE_SUMMARY_MIN_WORDS=200

# PR Monitoring Configuration
# How often to poll PR status (seconds)
PR_POLL_INTERVAL_SECONDS=30
# Maximum time to wait for PR to be ready before timing out (minutes)
PR_MAX_WAIT_MINUTES=30

# Main Loop Configuration
# How long to wait between research runs (seconds)
LOOP_INTERVAL_SECONDS=60

# Disable color output in logs
NO_COLOR=0