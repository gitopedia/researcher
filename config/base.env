# GitHub Configuration
# Option 1: Personal Access Token (PAT)
GITHUB_TOKEN=

# Option 2: GitHub App Authentication (recommended)
# App ID from GitHub App settings
GITHUB_APP_ID=
# Path to private key PEM file, OR the key content itself
GITHUB_APP_PRIVATE_KEY_PATH=
# OR use GITHUB_APP_PRIVATE_KEY to provide key content directly
# GITHUB_APP_PRIVATE_KEY=
# Installation ID (optional - will auto-detect if not provided)
# GITHUB_APP_INSTALLATION_ID=

# LLM Configuration (Ollama / self-hosted)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

LLM_MODEL_FAST=qwen3:8b           # Fast tasks (5.6GB)
LLM_MODEL_ARTICLE=deepseek-r1:14b # Article generation (9GB)

# When enabled, uses Ollama's "think" capability for supported models (qwen3, deepseek-r1, gpt-oss).
# This improves instruction following by allowing the model to reason before responding.
# For gpt-oss, use values: low, medium, high. For other models, use: true/false
LLM_THINK_MODE=true

# DuckDuckGo Web Search Config
# Search results to grab, too many seems to break
SEARCH_RESULTS_PER_QUERY=20
# Max characters of raw page text to keep before summarization
# (200000 ≈ ~57k–70k tokens of raw text; summarization will compress this to fit in 40k token context)
SEARCH_MAX_CHARS=200000

# Main Loop Configuration
# How long to wait between research runs (seconds)
LOOP_INTERVAL_SECONDS=60

# Topic Processing Configuration
# Number of article iterations per claimed topic before submitting PR
TOPIC_PROCESSING_ITERATIONS=10
# Improvement passes after creating a new article
IMPROVEMENTS_PER_NEW_ARTICLE=10
# Whether to create a PR after completing iterations (false = just commit to branch)
CREATE_PR_AFTER_ITERATIONS=false

# PR Management
# Whether to automatically merge ready PRs at the start of each run (default: disabled)
AUTO_MERGE_READY_PRS=false

# Image Generation Configuration
# Whether to run image generation as a finalization step after research iterations
GENERATE_IMAGES_AFTER_RUN=true
# ComfyUI API URL for image generation
COMFYUI_URL=http://localhost:8188
# Header image dimensions (for article banners)
IMAGE_HEADER_WIDTH=1920
IMAGE_HEADER_HEIGHT=1080
# Ollama service name (for systemctl) or path
OLLAMA_SERVICE=ollama
# Path to ComfyUI main.py (optional - will try common locations if not set)
# COMFYUI_PATH=
# Python command for launching ComfyUI
PYTHON_CMD=python
# Path to config directory for artistic_styles.yaml and image_prompt_templates.yaml
CONFIG_DIR=config

# Knowledge-Base Integration
# Enable storing/querying sources via knowledge-base API
USE_KNOWLEDGE_BASE=false
# Knowledge-base API URL
KB_API_URL=http://localhost:8081

# Disable color output in logs
NO_COLOR=0
